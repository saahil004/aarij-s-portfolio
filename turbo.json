{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "SHOW_DRAFTS", "VERCEL_ENV", "VERCEL_PROJECT_PRODUCTION_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
