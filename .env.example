# Copy to apps/web/.env.local for local development. Never commit real values.

# Public origin used for canonical URLs, sitemap and social cards.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Hono API on Cloudflare Workers (Phase 3).
# While unset, the contact form explains that messages can't be sent yet.
NEXT_PUBLIC_API_URL=

# Set to 1 to show draft blog posts in a production build (previews only).
SHOW_DRAFTS=
